      "definitions": []
    },
    {
      "clause_id": "CLAUSE-DOC018-6.1",
      "clause_number": "6.1",
      "title": "Compressive Strength",
      "content": "Compressive Strength: For 53 Grade OPC, the 28-day compressive strength shall not be less than 53 MPa (53 N/mm²). 7-day strength shall not be less than 37 MPa. 3-day strength shall not be less than 27 MPa.",
      "page_start": 2,
      "page_end": 3,
      "page_refs": [
        2,
        3
      ],
      "subclauses": [],
      "semantic_type": "acceptance_criterion",
