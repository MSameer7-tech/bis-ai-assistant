      "clause_id": "CLAUSE-DOC018-1",
      "clause_number": "1",
      "title": "Scope",
      "content": "Scope: This Indian Standard (IS 269 : 2015) covers and specifies requirements for Ordinary Portland Cement - Specification (Sixth Revision). It applies to ordinary_portland_cement_53 under cement category in the construction_civil domain.",
      "page_start": 1,
      "page_end": 1,
      "page_refs": [
        1
      ],
      "subclauses": [],
      "semantic_type": "scope",
      "semantic_tags": [
        "scope"
      ],
