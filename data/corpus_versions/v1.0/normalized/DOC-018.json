        "acceptance_criterion",
        "requirement"
      ],
      "requirements": [],
      "definitions": []
    },
    {
      "clause_id": "CLAUSE-DOC018-6.4",
      "clause_number": "6.4",
      "title": "Soundness",
      "content": "Soundness: Expansion by Le-Chatelier method shall not exceed 10 mm; by Autoclave method shall not exceed 0.8%.",
      "page_start": 5,
      "page_end": 6,
      "page_refs": [
        5,
        6
      ],
