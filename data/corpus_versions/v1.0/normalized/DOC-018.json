        "requirement"
      ],
      "requirements": [],
      "definitions": []
    },
    {
      "clause_id": "CLAUSE-DOC018-6.2",
      "clause_number": "6.2",
      "title": "Setting Time",
      "content": "Setting Time: Initial setting time shall not be less than 30 min. Final setting time shall not exceed 600 min.",
      "page_start": 3,
      "page_end": 4,
      "page_refs": [
        3,
        4
      ],
      "subclauses": [],
      "semantic_type": "acceptance_criterion",
