      ],
      "requirements": [],
      "definitions": []
    },
    {
      "clause_id": "CLAUSE-DOC018-6.3",
      "clause_number": "6.3",
      "title": "Fineness",
      "content": "Fineness: Specific surface area by Blaine air permeability method shall not be less than 225 m²/kg.",
      "page_start": 4,
      "page_end": 5,
      "page_refs": [
        4,
        5
      ],
      "subclauses": [],
      "semantic_type": "acceptance_criterion",
