    {
      "clause_id": "CLAUSE-DOC026-9.2",
      "clause_number": "9.2",
      "title": "Retention System Strength",
      "content": "Retention System Strength: Dynamic extension of chin strap shall not exceed 35 mm under 1 kN dynamic shock load; residual extension shall not exceed 25 mm.",
