    },
    {
      "clause_id": "CLAUSE-DOC029-7.3.2",
      "clause_number": "7.3.2",
      "title": "External Short Circuit",
      "content": "External Short Circuit: Short circuit at 55°C with external resistance < 80 mΩ; cell shall not catch fire or explode; case temperature shall not exceed 150°C.",
