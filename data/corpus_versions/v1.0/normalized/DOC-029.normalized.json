      "clause_number": "7.2.1",
      "title": "Continuous Charging",
      "content": "Continuous Charging: Fully charged cells subjected to continuous 28-day charging without fire or explosion.",
      "page_start": 2,
      "page_end": 3,
      "page_refs": [
        2,
