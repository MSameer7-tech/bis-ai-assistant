      "clause_id": "CLAUSE-DOC033-5.2",
      "clause_number": "5.2",
      "title": "Shear Adhesion Strength",
      "content": "Shear Adhesion Strength: Shear adhesion strength after 14 days dry curing shall be >= 1.25 N/mm².",
