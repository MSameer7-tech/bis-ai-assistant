      "clause_number": "5.1",
      "title": "Tensile Adhesion Strength",
      "content": "Tensile Adhesion Strength: Type 2 tile adhesive 28-day tensile adhesion strength shall be >= 1.0 N/mm² under dry conditions.",
      "page_start": 2,
      "page_end": 3,
