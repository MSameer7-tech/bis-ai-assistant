      "clause_id": "CLAUSE-DOC027-7.1",
      "clause_number": "7.1",
      "title": "Operating Pressure",
      "content": "Operating Pressure: Operating pressure regulated by weight valve shall be 1.0 bar (100 kPa ± 10 kPa).",
      "page_start": 2,
      "page_end": 3,
      "page_refs": [
        2,
