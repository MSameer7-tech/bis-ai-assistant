    {
      "clause_id": "CLAUSE-DOC027-7.2",
      "clause_number": "7.2",
      "title": "Safety Pressure Release Device",
      "content": "Safety Pressure Release Device: Safety valve/fusible plug shall release pressure between 1.4 bar and 2.0 bar (140 kPa to 200 kPa).",
      "page_start": 3,
      "page_end": 4,
      "page_refs": [
        3,
