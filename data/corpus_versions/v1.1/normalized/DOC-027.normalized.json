      "clause_id": "CLAUSE-DOC027-1",
      "clause_number": "1",
      "title": "Scope",
      "content": "Scope: This Indian Standard (IS 2347 : 2017) covers and specifies requirements for Domestic Pressure Cookers - Specification (Fifth Revision). It applies to domestic_pressure_cookers under domestic_appliances_gas category in the mechanical_automotive domain.",
      "page_start": 1,
      "page_end": 1,
