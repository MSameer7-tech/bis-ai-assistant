    },
    {
      "clause_id": "CLAUSE-DOC032-8.2",
      "clause_number": "8.2",
      "title": "Long-Term Hydrostatic Test",
      "content": "Long-Term Hydrostatic Test: 1000 h hydrostatic test at 60°C with 4.2 MPa hoop stress without failure.",
      "page_start": 3,
      "page_end": 4,
      "page_refs": [
        3,
        4
      ],
