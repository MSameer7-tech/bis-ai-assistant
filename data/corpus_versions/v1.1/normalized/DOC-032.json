      "clause_id": "CLAUSE-DOC032-1",
      "clause_number": "1",
      "title": "Scope",
      "content": "Scope: This Indian Standard (IS 4985 : 2021) covers and specifies requirements for Unplasticized Polyvinyl Chloride (uPVC) Pipes for Potable Water Supplies - Specification (Fourth Revision). It applies to upvc_pipes_potable_water under polymers_pipes category in the chemicals_polymers domain.",
      "page_start": 1,
      "page_end": 1,
