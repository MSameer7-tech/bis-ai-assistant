    {
      "clause_id": "CLAUSE-DOC032-8.1",
      "clause_number": "8.1",
      "title": "Hydrostatic Pressure Test",
      "content": "Hydrostatic Pressure Test: Pipes shall withstand internal hydrostatic pressure test at 27°C with circumferential hoop stress of 10.0 MPa for 1 h without burst.",
      "page_start": 2,
      "page_end": 3,
      "page_refs": [
        2,
        3
      ],
