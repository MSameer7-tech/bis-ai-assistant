    {
      "clause_id": "CLAUSE-DOC032-9.1",
      "clause_number": "9.1",
      "title": "Impact Test (Falling Weight)",
      "content": "Impact Test (Falling Weight): Striker dropped from 2.0 m height on pipe cooled to 0°C; True Impact Rate of Failure (TIR) shall not exceed 10%.",
      "page_start": 4,
      "page_end": 5,
