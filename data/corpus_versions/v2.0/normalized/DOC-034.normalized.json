      "clause_id": "CLAUSE-DOC034-7.1",
      "clause_number": "7.1",
      "title": "Yield Stress",
      "content": "Yield Stress: Fe 500D minimum proof stress 500 MPa; Fe 550D minimum 550 MPa; Fe 650 minimum 650 MPa (new high-grade steel introduction).",
      "page_start": 2,
      "page_end": 3,
