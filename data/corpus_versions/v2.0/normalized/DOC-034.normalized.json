    {
      "clause_id": "CLAUSE-DOC034-7.2",
      "clause_number": "7.2",
      "title": "Tensile Strength",
      "content": "Tensile Strength: For Fe 500D, minimum tensile strength 565 MPa (TS/YS ratio >= 1.12 for seismic earthquake resistance zones).",
      "page_start": 3,
      "page_end": 4,
