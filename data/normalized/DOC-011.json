      "definitions": []
    },
    {
      "clause_number": "2",
      "title": "Amendment in the Schedule",
      "parent_clause": null,
      "depth": 1,
      "page_start": 1,
      "page_end": 1,
      "page_refs": [
        1
      ],
      "content": "2. Amendment in the Schedule.?\nIn the Schedule to the Electronics and Information Technology Goods (Requirement of Compulsory\nRegistration) Order, 2021:\nFor the entry relating to 'Self-Ballasted LED Lamps for General Lighting Services', the corresponding standard\nIS 16102 (Part 1):2012 shall stand amended to include IS 16102 (Part 1):2026 (First Revision).\nThe concurrent implementation and transition guidelines issued by the Bureau of Indian Standards shall apply.",
      "subclauses": [],
      "semantic_type": "reference",
      "semantic_tags": [
        "reference",
