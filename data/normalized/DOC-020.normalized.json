    {
      "clause_id": "CLAUSE-DOC020-7.3",
      "clause_number": "7.3",
      "title": "Elongation",
      "content": "Elongation: Minimum percentage elongation on gauge length 5.65√A shall be 14.5% for Fe 415, 12.0% for Fe 500, 10.0% for Fe 550, and 10.0% for Fe 600.",
