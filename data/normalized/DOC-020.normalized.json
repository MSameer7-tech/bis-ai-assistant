    {
      "clause_id": "CLAUSE-DOC020-7.1",
      "clause_number": "7.1",
      "title": "Yield Stress (0.2% Proof Stress)",
      "content": "Yield Stress (0.2% Proof Stress): Fe 415 minimum 415 N/mm² (415 MPa); Fe 500 minimum 500 N/mm² (500 MPa); Fe 550 minimum 550 N/mm² (550 MPa); Fe 600 minimum 600 N/mm² (600 MPa).",
      "page_start": 2,
      "page_end": 3,
      "page_refs": [
        2,
        3
      ],
