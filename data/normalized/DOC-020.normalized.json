      "clause_id": "CLAUSE-DOC020-1",
      "clause_number": "1",
      "title": "Scope",
      "content": "Scope: This Indian Standard (IS 1786 : 2008) covers and specifies requirements for High Strength Deformed Steel Bars and Wires for Concrete Reinforcement - Specification (Fourth Revision). It applies to high_strength_deformed_steel_bars under steel_metals category in the construction_civil domain.",
      "page_start": 1,
      "page_end": 1,
