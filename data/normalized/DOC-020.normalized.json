    },
    {
      "clause_id": "CLAUSE-DOC020-7.2",
      "clause_number": "7.2",
      "title": "Tensile Strength (TS)",
      "content": "Tensile Strength (TS): For Fe 500, minimum tensile strength shall be 545 N/mm² (TS/YS ratio >= 1.08).",
      "page_start": 3,
      "page_end": 4,
      "page_refs": [
        3,
