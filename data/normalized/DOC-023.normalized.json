    {
      "clause_id": "CLAUSE-DOC023-5.1",
      "clause_number": "5.1",
      "title": "Chemical Contaminants",
      "content": "Chemical Contaminants: Lead maximum 0.01 mg/L; Arsenic maximum 0.01 mg/L; Fluoride maximum 1.0 mg/L; Nitrate maximum 45 mg/L.",
      "page_start": 5,
      "page_end": 6,
      "page_refs": [
        5,
        6
      ],
      "subclauses": [],
      "semantic_type": "requirement",
