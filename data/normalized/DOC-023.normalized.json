    {
      "clause_id": "CLAUSE-DOC023-4.1",
      "clause_number": "4.1",
      "title": "Organoleptic and Physical Parameters",
      "content": "Organoleptic and Physical Parameters: pH shall be in the range 6.5 to 8.5.",
      "page_start": 2,
      "page_end": 3,
      "page_refs": [
        2,
        3
