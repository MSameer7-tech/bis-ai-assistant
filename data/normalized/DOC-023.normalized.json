    },
    {
      "clause_id": "CLAUSE-DOC023-4.2",
      "clause_number": "4.2",
      "title": "Total Dissolved Solids (TDS)",
      "content": "Total Dissolved Solids (TDS): Total dissolved solids shall be between 75 mg/L and 500 mg/L.",
      "page_start": 3,
      "page_end": 4,
      "page_refs": [
        3,
        4
      ],
