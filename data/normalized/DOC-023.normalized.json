    {
      "clause_id": "CLAUSE-DOC023-4.3",
      "clause_number": "4.3",
      "title": "Turbidity",
      "content": "Turbidity: Turbidity shall not exceed 2 NTU.",
      "page_start": 4,
      "page_end": 5,
      "page_refs": [
        4,
        5
      ],
