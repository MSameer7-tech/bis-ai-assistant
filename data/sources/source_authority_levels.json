{
  "manifest_version": "1.1",
  "phase": "Phase 2B: Official Source Registry",
  "project": "BIS AI Technical Assistant",
  "description": "Taxonomy of authority levels, distinguishing Source Authority, Claim Authority, and Legal Mandate Basis.",
  "legal_mandate_hierarchy": {
    "description": "Evidence chain required to establish that BIS certification is legally mandatory vs voluntary.",
    "resolution_chain": [
      "1. Actual Gazette Notification (S.O. instrument published in The Gazette of India)",
      "2. Statutory Ministry Order (DPIIT, MeitY, MoEFCC, MoS, etc.)",
      "3. Governing Indian Standard Scope & Clauses",
      "4. Official BIS Implementation Portal Information"
    ]
  },
  "authority_levels": [
    {
      "level": "LEVEL_A",
      "code": "PRIMARY_NORMATIVE",
      "name": "Primary Normative Statutory Evidence",
      "governing_statute": "BIS Act 2016 & The Gazette of India",
      "eligible_sources": ["SRCF-001", "SRCF-002", "SRCF-003", "SRCF-005", "SRCF-006", "SRCF-009A", "SRCF-009C"],
      "allowed_claims": [
        "TECHNICAL_SPECIFICATION",
        "PERFORMANCE_PARAMETER",
        "DIMENSIONAL_TOLERANCE",
