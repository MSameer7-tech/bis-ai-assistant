        "TEST_METHOD",
        "MANDATORY_LEGAL_STATUS",
        "ROUTINE_TEST_FREQUENCY",
        "PURITY_SPECIFICATION"
      ],
      "requires_clause_citation": true,
      "requires_hash_provenance": true
    },
    {
      "level": "LEVEL_B",
      "code": "OFFICIAL_OPERATIONAL",
      "name": "Official Operational & Procedural Knowledge",
      "governing_statute": "BIS CMD / LPCD Guidelines",
      "eligible_sources": ["SRCF-004", "SRCF-007", "SRCF-008", "SRCF-009D", "SRCF-009E", "SRCF-009F", "SRCF-010"],
      "allowed_claims": [
        "CERTIFICATION_PROCEDURE",
